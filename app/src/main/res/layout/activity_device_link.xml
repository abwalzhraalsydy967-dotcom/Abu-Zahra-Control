<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary" android:padding="24dp">
    <ImageView android:id="@+id/ivBack" android:layout_width="32dp" android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_revert" app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="ربط جهاز جديد" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivBack" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/tvDesc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="أدخل كود الربط الذي يظهر على الجهاز المستهدف" android:textColor="@color/text_secondary" android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilCode"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="40dp" android:hint="@string/enter_link_code" app:boxStrokeColor="@color/primary" app:hintTextColor="@color/primary"
        app:startIconDrawable="@android:drawable/ic_menu_share" app:startIconTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/tvDesc" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textCapCharacters" android:textAllCaps="true"
            android:textColor="@color/text_primary" android:textSize="20sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnLink" android:layout_width="0dp" android:layout_height="56dp"
        android:layout_marginTop="24dp" android:background="@drawable/bg_gradient_button" android:text="@string/link_device"
        android:textColor="@color/white" android:textSize="16sp" app:backgroundTint="@null" app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/tilCode" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:textColor="@color/text_secondary" android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/btnLink" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
